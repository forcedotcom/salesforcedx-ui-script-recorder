{
  "name": "sf-ui-recorder",
  "displayName": "Salesforce UI Script Recorder",
  "version": "1.4.0",
  "description": "VS Code Extension wrapping a CLI tool for recording Salesforce UI browser interactions with an overlay interface",
  "publisher": "salesforce",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/salesforcedx-ui-script-recorder.git"
  },
  "icon": "images/icon.png",
  "readme": "README.md",
  "type": "module",
  "main": "./vscode-extension/extension.js",
  "bin": {
    "sf-ui-recorder": "./recorder-cli/bin/cli.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:javascript",
    "onView:sfUiRecorderRecordings"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sf-ui-recorder",
          "title": "Salesforce UI Script Recorder",
          "icon": "images/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "sf-ui-recorder": [
        {
          "id": "sfUiRecorderRecordings",
          "name": "Recordings"
        },
        {
          "id": "sfUiRecorderUserFiles",
          "name": "User Files",
          "visibility": "collapsed"
        },
        {
          "id": "sfUiRecorderDataFiles",
          "name": "Data Files",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "sf-ui-recorder.startRecording",
        "title": "Start UI Recording",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(record)"
      },
      {
        "command": "sf-ui-recorder.playbackScript",
        "title": "Play Recording",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(play)"
      },
      {
        "command": "sf-ui-recorder.parameterizeStep",
        "title": "Parameterize Step",
        "category": "Salesforce UI Script Recorder"
      },
      {
        "command": "sf-ui-recorder.reconvert",
        "title": "Re-convert to Playwright",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(refresh)"
      },
      {
        "command": "sf-ui-recorder.installAgentforceMcpConfig",
        "title": "Install Agentforce MCP Server Config",
        "category": "Salesforce UI Script Recorder"
      },
      {
        "command": "sf-ui-recorder.viewResults",
        "title": "View Playback Results",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(graph)"
      },
      {
        "command": "sf-ui-recorder.viewRecordingHistory",
        "title": "View History",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(history)"
      },
      {
        "command": "sf-ui-recorder.playRecording",
        "title": "Play Recording",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(play)"
      },
      {
        "command": "sf-ui-recorder.renameRecording",
        "title": "Rename Recording",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(edit)"
      },
      {
        "command": "sf-ui-recorder.deleteRecording",
        "title": "Delete Recording",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(trash)"
      },
      {
        "command": "sf-ui-recorder.infoUserFiles",
        "title": "What are User Files?",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(info)"
      },
      {
        "command": "sf-ui-recorder.infoDataFiles",
        "title": "What are Data Files?",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(info)"
      },
      {
        "command": "sf-ui-recorder.revealUserFilesInExplorer",
        "title": "View in Explorer",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sf-ui-recorder.revealDataFilesInExplorer",
        "title": "View in Explorer",
        "category": "Salesforce UI Script Recorder",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sf-ui-recorder.parameterizeStep",
          "when": "false"
        },
        {
          "command": "sf-ui-recorder.infoUserFiles",
          "when": "false"
        },
        {
          "command": "sf-ui-recorder.infoDataFiles",
          "when": "false"
        },
        {
          "command": "sf-ui-recorder.revealUserFilesInExplorer",
          "when": "false"
        },
        {
          "command": "sf-ui-recorder.revealDataFilesInExplorer",
          "when": "false"
        },
        {
          "command": "sf-ui-recorder.deleteRecording",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "sf-ui-recorder.playbackScript",
          "when": "resourceFilename =~ /\\.spec\\.js$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "sf-ui-recorder.startRecording",
          "when": "view == sfUiRecorderRecordings",
          "group": "navigation"
        },
        {
          "command": "sf-ui-recorder.revealUserFilesInExplorer",
          "when": "view == sfUiRecorderUserFiles",
          "group": "navigation@1"
        },
        {
          "command": "sf-ui-recorder.infoUserFiles",
          "when": "view == sfUiRecorderUserFiles",
          "group": "navigation@2"
        },
        {
          "command": "sf-ui-recorder.revealDataFilesInExplorer",
          "when": "view == sfUiRecorderDataFiles",
          "group": "navigation@1"
        },
        {
          "command": "sf-ui-recorder.infoDataFiles",
          "when": "view == sfUiRecorderDataFiles",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sf-ui-recorder.playRecording",
          "when": "view == sfUiRecorderRecordings && viewItem == recording || view == sfUiRecorderRecordings && viewItem == recordingWithResults",
          "group": "inline@1"
        },
        {
          "command": "sf-ui-recorder.viewRecordingHistory",
          "when": "view == sfUiRecorderRecordings && viewItem == recordingWithResults",
          "group": "inline@2"
        },
        {
          "command": "sf-ui-recorder.renameRecording",
          "when": "view == sfUiRecorderRecordings && viewItem == recording || view == sfUiRecorderRecordings && viewItem == recordingWithResults",
          "group": "inline@3"
        },
        {
          "command": "sf-ui-recorder.playRecording",
          "when": "view == sfUiRecorderRecordings && viewItem == recording || view == sfUiRecorderRecordings && viewItem == recordingWithResults",
          "group": "1_actions@1"
        },
        {
          "command": "sf-ui-recorder.viewRecordingHistory",
          "when": "view == sfUiRecorderRecordings && viewItem == recordingWithResults",
          "group": "1_actions@2"
        },
        {
          "command": "sf-ui-recorder.renameRecording",
          "when": "view == sfUiRecorderRecordings && viewItem == recording || view == sfUiRecorderRecordings && viewItem == recordingWithResults",
          "group": "7_modification@1"
        },
        {
          "command": "sf-ui-recorder.deleteRecording",
          "when": "view == sfUiRecorderRecordings && viewItem == recording || view == sfUiRecorderRecordings && viewItem == recordingWithResults",
          "group": "7_modification@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sfUiRecorderRecordings",
        "contents": "No recordings yet.\n[Start UI Recording](command:sf-ui-recorder.startRecording)"
      }
    ]
  },
  "scripts": {
    "start": "node recorder-cli/bin/cli.js",
    "mcp": "node mcp-server/index.js",
    "build:injected": "node recorder-cli/scripts/build-injected.js",
    "prepackage": "npm run build:injected",
    "package": "vsce package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.44.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "lodash-es": "^4.17.21",
    "playwright": "^1.44.0",
    "prettier": "^3.8.3",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.0"
  }
}
